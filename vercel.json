{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/:locale(es|ca|en|fr)/servicios/ia-pymes",
      "destination": "/:locale/servicios/transporte-especial",
      "permanent": true
    },
    {
      "source": "/:locale(es|ca|en|fr)/socios",
      "destination": "/:locale/sobre-nosotros",
      "permanent": true
    },
    {
      "source": "/:locale(es|ca|en|fr)/servicios/formacion-senior",
      "destination": "/:locale",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "(.*)",
      "destination": "/index.html"
    }
  ]
}
